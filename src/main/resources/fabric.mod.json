{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Vanilla-like Minecraft guns [Bren Legacy Port]",
  "authors": [
    "goldbocman"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/vanilla-guns-mod",
    "sources": "https://github.com/goldbocman/bren_port"
  },
  "license": "CC0-1.0",
  "icon": "assets/vgm/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.goldbocman.vgm.TemplateModFabric"
    ],
    "client": [
      "com.goldbocman.vgm.client.ClientBren"
    ],
    "fabric-datagen": [
      "com.goldbocman.vgm.datagen.VgmFabricDataGenerator"
    ]
  },
  "mixins": [
    "vgm.mixins.json"
  ],
  "accessWidener": "vgm.ct",
  "depends": {
    "fabricloader": ">=0.17",
